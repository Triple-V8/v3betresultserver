# ── V3 Bet sports oracle ─────────────────────────────────────────────────
# Copy to `.env` for local dev. Never commit `.env`.

PORT=8788

# Chain id — 84532 = Base Sepolia, 8453 = Base mainnet.
CHAIN_ID=84532

# Deployed unified P2PBetting contract address (from the deploy script).
P2P_BETTING_ADDRESS=

# Operator wallet private key (the propose-bot — wallet #1 of the two).
# Generate with `openssl rand -hex 32`, prefix `0x`. Keep secret.
# Must be registered on the contract via `addOperator(<address>)`.
OPERATOR_PRIVATE_KEY=

# Read RPC URL. Default to the chain's public endpoint; override with a
# paid endpoint (Alchemy/Infura) in production for throughput.
RPC_URL=

# AllSportsAPI key — server-side only.
ALLSPORTSAPI_KEY=

# Vercel KV — set automatically by the Vercel integration. For local dev,
# leave these empty and the in-memory fallback kicks in.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Cron secret. Vercel sets this on cron invocations as
# `Authorization: Bearer <CRON_SECRET>` so unauth callers can't trigger it.
CRON_SECRET=

# CORS — comma-separated origins allowed to call /games/ensure & /games/track.
ALLOWED_ORIGINS=http://localhost:5173,https://v3bet.xyz

# Resend API key — server-side only. Get one at https://resend.com.
# Used for: withdrawal verification codes (#2) + new-device sign-in alerts (#5b).
RESEND_API_KEY=

# "From" address for the emails Resend sends. Must be on a domain you've
# verified in the Resend dashboard. While testing you can use
# onboarding@resend.dev (Resend's shared sender) — switch to your own
# domain before production.
RESEND_FROM_EMAIL=V3 Bet <noreply@v3bet.xyz>

# Optional override for the URL embedded in user-facing emails ("review
# activity / revoke device" link). Defaults to the first ALLOWED_ORIGINS entry.
PUBLIC_APP_URL=https://v3bet.xyz
